+REQUIRED_COLUMNS_FIX = "Bind every required column or choose a chart type that can represent them."
+
+
+def _missing_required(parsed: models.Spec, deps: DesignerDeps) -> list[str]:
+    """Required result columns the spec leaves unbound; a table binds every column."""
+    used = set(deps.report.result.columns) if parsed.type == "table" else set(parsed.bind.values()) | set(parsed.fold)
+    for card in parsed.cards:
+        used.update([card.value, *card.context, *card.support])
+    return [name for name in deps.required_columns if name not in used]
+
+
 def offer_check_spec(ctx: RunContext[DesignerDeps], tool_def: ToolDefinition) -> ToolDefinition | None:
     return None if ctx.deps.check_calls >= MAX_CHECK_CALLS else tool_def
 
