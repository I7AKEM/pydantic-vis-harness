+REQUIRED_COLUMNS_FIX = "Bind every required column or choose a chart type that can represent them."
+
+
+def _parsed_or_none(text: str) -> models.Spec | None:
+    try:
+        return parse(text)
+    except models.SpecError:
+        return None
+
+
+def _required_column_violations(parsed: models.Spec | None, deps: DesignerDeps) -> list[models.Violation]:
+    """The executable requirement both tools enforce: every required result column is bound. A table binds all."""
+    if parsed is None:
+        return []
+    used = set(deps.report.result.columns) if parsed.type == "table" else set(parsed.bind.values()) | set(parsed.fold)
+    for card in parsed.cards:
+        used.update([card.value, *card.context, *card.support])
+    missing = [name for name in deps.required_columns if name not in used]
+    if not missing:
+        return []
+    return [models.Violation(rule="required_columns",
+                             message="the chart omits required result columns " + ", ".join(missing),
+                             fix=REQUIRED_COLUMNS_FIX)]
 
 
