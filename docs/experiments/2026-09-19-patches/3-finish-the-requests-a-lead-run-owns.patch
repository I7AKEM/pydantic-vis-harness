+async def own_request(ctx: RunContext[AppDeps], request) -> None:
+    """Record which lead run is working on the request, so only that run's end can close it."""
+    request.steps["lead_run_id"] = ctx.run_id
+    await asyncio.to_thread(requests_of(ctx.deps).save_request, request)
+
+
+def request_cleanup() -> Hooks:
+    """Close what this run leaves running: failed after an error or cancellation, stopped after a turn that ended
+    without publishing. Explicit completion handling, not a workflow step; the lead still chooses every action."""
+    hooks = Hooks()
+
+    @hooks.on.run
+    async def finish_owned_requests(ctx: RunContext[AppDeps], *, handler):
+        try:
+            result = await handler()
+        except BaseException as exc:
+            with CancelScope(shield=True):
+                await finish_lead_run(ctx.deps, ctx.conversation_id, ctx.run_id, error=str(exc) or type(exc).__name__)
+            raise
+        await finish_lead_run(ctx.deps, ctx.conversation_id, ctx.run_id, error=None)
+        return result
+
+    return hooks
+
