+async def finish_lead_run(deps: AppDeps, conversation_id: str | None, run_id: str | None, *,
+                          error: str | None) -> list[str]:
+    """Close the requests this run opened or resumed and left running: failed when the run raised, stopped when it
+    ended without publishing. Requests owned by other runs are untouched; resume reactivates a stopped request."""
+    if deps.requests is None or not conversation_id or not run_id:
+        return []
+    store = requests_of(deps)
+    finished = []
+    for summary in await asyncio.to_thread(store.list_requests, conversation_id=conversation_id, unfinished_only=True):
+        async with request_lock(summary.request_id):
+            request = await asyncio.to_thread(store.get_request, summary.request_id)
+            if request.status != "running" or request.steps.get("lead_run_id") != run_id:
+                continue
+            request.status = "failed" if error else "stopped"
+            request.error = error or "The lead ended its turn without publishing this request; resume continues it."
+            await asyncio.to_thread(store.save_request, request)
+            finished.append(request.request_id)
+    return finished
 
 
