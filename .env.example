# Copy this file to .env, then fill in one provider:
#
#   cp .env.example .env
#
# A provider is the only required setting. Every other line has a working default; leave it empty
# to take that default. An existing value always wins, so a stale line here overrides a new default.
# .env is not in git. Never commit a key.

# --- Provider: set at least one ---------------------------------------------------------------
# OpenRouter. Create a key at https://openrouter.ai/keys and paste it here.
OPENROUTER_API_KEY=
# The LiteLLM proxy (the air-gapped cluster): its base URL, its key, and the model name it serves.
# Set all three. The reviewer there uses LITELLM_REVIEWER_MODEL; the other agents run LOCAL_LLM,
# and the lead has no advisor.
LITELLM_BASE_URL=
LITELLM_TOKEN=
LOCAL_LLM=
# The chat's dropdown lists each provider that is configured and selects the whole team.
# OpenRouter comes first when both are set, and the first team also serves the agent API.

# --- Local storage and logging ----------------------------------------------------------------
# Uploads, the DuckDB file, and published charts. The directory is created on first use.
# DATA_DIRECTORY=./data
# DUCKDB_PATH=./data/datasets.duckdb
# The largest CSV the upload routes accept.
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
# Optional: send traces to Logfire when set.
# LOGFIRE_TOKEN=

# --- Models: override only what you have evaluated ---------------------------------------------
# The lead's OpenRouter model. Empty means the text-only openrouter:z-ai/glm-5.3.
# Overrides must support tool calls; rendered images are inspected by the reviewer instead.
# Native OpenRouter settings enable low-effort thinking.
PYDANTIC_AI_MODEL=
# Optional: thinking effort. GLM 5.3 uses low by default.
PYDANTIC_AI_LEAD_REASONING_EFFORT=low
# Optional: the profiler model. Empty means openrouter:z-ai/glm-5.3 with low reasoning.
# Other overrides run with reasoning switched off unless they are from the GLM 5.3 family.
PYDANTIC_AI_PROFILER_MODEL=
# Optional: the analyst's model. Empty means the profiler's model.
PYDANTIC_AI_ANALYST_MODEL=
# Optional: the designer's model. Empty means openrouter:deepseek/deepseek-v4-pro.
PYDANTIC_AI_DESIGNER_MODEL=
# Optional: an alternate designer the lead may explicitly choose after a failed attempt.
# Empty uses the same tested DeepSeek V4 Pro model; set this only when an alternate has been evaluated.
PYDANTIC_AI_DESIGNER_FALLBACK_MODEL=
# Optional: the scoped visual reviewer's model; must read images. Empty means
# openrouter:google/gemma-4-31b-it.
PYDANTIC_AI_REVIEWER_MODEL=
# Optional: the reviewer's model on the LiteLLM proxy. Default Qwen/Qwen3.8-27B.
LITELLM_REVIEWER_MODEL=
# Optional: an Advisor model for difficult decisions. Empty (the default) avoids another model call.
PYDANTIC_AI_ADVISOR_MODEL=

# --- Evaluations and tests only -----------------------------------------------------------------
# Optional: the model that rewrites instructions in the DSPy optimizers under evals/.
# Empty means anthropic/claude-sonnet-4.6. Needs `uv sync --group optimize`.
# OPTIMIZE_REFLECTION_MODEL=
# Optional: set to any value to keep the PNGs the renderer tests draw, instead of deleting them.
# VIS_KEEP_IMAGES=
