# Providers. The chat's dropdown lists each one that is configured: OpenRouter when OPENROUTER_API_KEY is set,
# LiteLLM when LITELLM_BASE_URL is set. At least one is required; OpenRouter comes first when both are set, and
# the first one profiles uploads and serves the agent channel.
OPENROUTER_API_KEY=replace-me
# A LiteLLM proxy (the air-gapped cluster): its base URL, its key, and the model name it serves. Every agent of
# the LiteLLM entry runs LOCAL_LLM; the lead has no advisor there.
LITELLM_BASE_URL=
LITELLM_TOKEN=
LOCAL_LLM=
# The lead's model. Empty means the profiler's model (openrouter:google/gemma-4-31b-it:nitro), which scored 18/21 on
# the lead evaluation at 3 s per turn on 2026-09-09; openrouter:anthropic/claude-sonnet-4.6 was the previous default.
PYDANTIC_AI_MODEL=

# Optional: the profiler's model. Empty means openrouter:google/gemma-4-31b-it:nitro, the fastest model in the
# Phase 1 benchmark (openai/gpt-5.4-mini is the most accurate). The profiler runs with reasoning switched off; endpoints that require
# reasoning (gpt-oss, GLM flash) reject that setting, so remove model_settings in profiler.py to use them.
PYDANTIC_AI_PROFILER_MODEL=
# Optional: the analyst's model. Empty means the profiler's model until the Phase 2 benchmark picks a default.
PYDANTIC_AI_ANALYST_MODEL=
# Optional: the designer's model. Empty means the profiler's model.
PYDANTIC_AI_DESIGNER_MODEL=
# Optional: the model the design step runs once more on when the designer fails. Empty means
# openrouter:anthropic/claude-sonnet-4.6, the one measured; any strong designer works.
PYDANTIC_AI_DESIGNER_FALLBACK_MODEL=
# DATA_DIRECTORY=./data
MAX_UPLOAD_MB=20
# Optional: the DuckDB file. Defaults to DATA_DIRECTORY/datasets.duckdb.
# DUCKDB_PATH=./data/datasets.duckdb
# Optional: the Advisor model. Empty disables the Advisor capability.
PYDANTIC_AI_ADVISOR_MODEL=openrouter:openai/gpt-5.6-sol
# Optional: send traces to Logfire when set.
# LOGFIRE_TOKEN=
LOG_LEVEL=INFO
