# Providers. The chat's dropdown lists each one that is configured: LiteLLM when LITELLM_BASE_URL is set,
# OpenRouter when OPENROUTER_API_KEY is set. At least one is required; OpenRouter comes first when both are set.
# The first team also serves the agent channel.
OPENROUTER_API_KEY=replace-me
# A LiteLLM proxy (the air-gapped cluster): its base URL, its key, and the model name it serves. The reviewer uses
# LITELLM_REVIEWER_MODEL; the other agents run LOCAL_LLM, and the lead has no advisor there.
LITELLM_BASE_URL=
LITELLM_TOKEN=
LOCAL_LLM=
# The lead's OpenRouter model. Empty means openrouter:z-ai/glm-5.3-flash, a multimodal model so the lead can
# inspect every rendered chart before publication. Overrides must accept image input as well as tool calls.
# Native OpenRouter settings enable low-effort thinking and prefer low-latency providers that support it.
PYDANTIC_AI_MODEL=
# Optional: thinking effort. GLM 5.3 Flash supports low (the latency default) and higher efforts.
PYDANTIC_AI_LEAD_REASONING_EFFORT=low

# Optional: the profiler's model. Empty means openrouter:google/gemma-4-31b-it:nitro, the fastest model in the
# Phase 1 benchmark (openai/gpt-5.4-mini is the most accurate). The profiler runs with reasoning switched off; endpoints that require
# reasoning (gpt-oss, GLM flash) reject that setting, so remove model_settings in profiler.py to use them.
PYDANTIC_AI_PROFILER_MODEL=
# Optional: the analyst's model. Empty means the profiler's model until the Phase 2 benchmark picks a default.
PYDANTIC_AI_ANALYST_MODEL=
# Optional: the designer's model. Empty means the profiler's model.
PYDANTIC_AI_DESIGNER_MODEL=
# Optional: an alternate designer the lead may explicitly choose after a failed attempt.
# Empty means openrouter:anthropic/claude-sonnet-4.6.
PYDANTIC_AI_DESIGNER_FALLBACK_MODEL=
# Optional: the reviewer's model; must read images. Empty means
# openrouter:openai/gpt-5.4; the agreement test in evals/reviewer picks the seat.
PYDANTIC_AI_REVIEWER_MODEL=
# Optional: the reviewer's model on the LiteLLM proxy. Default Qwen/Qwen3.8-27B.
LITELLM_REVIEWER_MODEL=
# DATA_DIRECTORY=./data
MAX_UPLOAD_MB=20
# Optional: the DuckDB file. Defaults to DATA_DIRECTORY/datasets.duckdb.
# DUCKDB_PATH=./data/datasets.duckdb
# Optional: an Advisor model for difficult decisions. Empty (the default) avoids another model call.
PYDANTIC_AI_ADVISOR_MODEL=
# Optional: send traces to Logfire when set.
# LOGFIRE_TOKEN=
LOG_LEVEL=INFO
